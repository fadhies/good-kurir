{
  "name": "Order",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "driver_id": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "food",
        "goods",
        "person"
      ]
    },
    "mode": {
      "type": "string",
      "enum": [
        "hemat",
        "cepat"
      ],
      "default": "hemat"
    },
    "store_name": {
      "type": "string"
    },
    "store_address": {
      "type": "string"
    },
    "store_lat": {
      "type": "number"
    },
    "store_lng": {
      "type": "number"
    },
    "destination_address": {
      "type": "string"
    },
    "destination_lat": {
      "type": "number"
    },
    "destination_lng": {
      "type": "number"
    },
    "notes": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending_match",
        "driver_assigned",
        "at_store",
        "awaiting_payment",
        "paid",
        "on_the_way",
        "completed",
        "cancelled"
      ],
      "default": "pending_match"
    },
    "item_cost": {
      "type": "number"
    },
    "delivery_fee": {
      "type": "number"
    },
    "app_fee": {
      "type": "number"
    },
    "admin_fee": {
      "type": "number"
    },
    "driver_earning": {
      "type": "number"
    },
    "total_amount": {
      "type": "number"
    },
    "distance_km": {
      "type": "number"
    },
    "store_bill_note": {
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "type"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.driver_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.driver_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}