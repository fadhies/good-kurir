{
  "name": "DriverRemittance",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "date": {
      "type": "string"
    },
    "amount": {
      "type": "number"
    },
    "transaction_count": {
      "type": "integer"
    },
    "proof_photo": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "submitted",
        "verified",
        "rejected"
      ],
      "default": "submitted"
    },
    "note": {
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "date",
    "amount",
    "proof_photo"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}